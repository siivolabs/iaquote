# Keep the real catalogue endpoint in Dockge/Compose secrets or environment.
# The value can end with / or contain a {code} placeholder.
CATALOG_SEARCH_BASE_URL=https://catalogue.example/recherche/{code}
CATALOG_MATCH_THRESHOLD=0.58
CATALOG_REQUEST_DELAY=1.0
DATABASE_PATH=/data/devisia.sqlite
BOOTSTRAP_CSV=
SECRET_KEY=replace-with-a-long-random-value
