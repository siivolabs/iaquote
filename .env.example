APP_PORT=8094
SECRET_KEY=remplacez-par-une-valeur-longue-et-aleatoire
TZ=Europe/Paris

# Service IA local. Utilisez une adresse privée dans votre fichier .env non versionné.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b
OLLAMA_TIMEOUT=240
SEND_COSTS_TO_OLLAMA=false

# Source technique externe. Renseignez ces valeurs uniquement dans le .env privé.
# Les modèles d'adresse acceptent {query}, {domain} et {raw_query}.
TECHNICAL_ALLOWED_HOSTS=
TECHNICAL_PRODUCT_PATH_MARKER=/fiche/
TECHNICAL_LINK_SELECTOR=a[href]
TECHNICAL_SEARCH_URL=
TECHNICAL_SEARCH_API_URL=
TECHNICAL_SEARCH_FALLBACK_URLS=
TECHNICAL_SEARCH_ALLOWED_HOSTS=
TECHNICAL_DEFAULT_DISCOVERY=true
TECHNICAL_SEARCH_STOP_SCORE=0.72
TECHNICAL_SEARCH_DELAY=2.5
TECHNICAL_SEARCH_TIMEOUT=25
TECHNICAL_REQUEST_DELAY=2.5
TECHNICAL_TIMEOUT=25
# Chaque import CSV place automatiquement tous les produits sans fiche dans
# une file persistante traitée en arrière-plan.
AUTO_ENRICH_ON_IMPORT=true

# Laissez vide en production : le catalogue commercial est importé depuis l'interface.
BOOTSTRAP_CSV=
PRESEED_PATH=
